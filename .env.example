# Public site configuration
NEXT_PUBLIC_SITE_URL=https://www.heydestudio.com
NEXT_PUBLIC_APP_URL=https://www.heydestudio.com

# Internal API protection
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# Calendly webhook protection
CALENDLY_WEBHOOK_TOKEN=replace-with-a-long-random-secret
CALENDLY_ACCESS_TOKEN=replace-with-calendly-personal-access-token

# Email provider: Brevo
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=contact@heydestudio.com
BREVO_NOTIFICATION_EMAIL=contact@heydestudio.com
BREVO_NEWSLETTER_LIST_ID=3

# CRM provider: HubSpot
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-private-app-token
HUBSPOT_DEAL_PIPELINE=default
# Existing commercial-pipeline stage used only by the explicit proposal action.
HUBSPOT_PROPOSAL_SENT_STAGE=contractsent
# Backwards-compatible fallback if already set in Vercel/local envs:
# HUBSPOT_API_KEY=replace-with-hubspot-private-app-token

# Audit funnel safety. INTERNAL_API_TOKEN is used as the idempotency secret when
# AUDIT_IDEMPOTENCY_SECRET is omitted.
AUDIT_IDEMPOTENCY_SECRET=replace-with-a-long-random-secret
AUDIT_DARK_MODE=true
AUDIT_FORM_ENABLED=false
AUDIT_TEST_EMAIL_ALLOWLIST=approved-test-recipient@example.com

# Analytics
NEXT_PUBLIC_GA_ID=G-X5ZD3ZGJ1Q
